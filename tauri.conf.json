{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koi",
  "version": "0.1.3",
  "identifier": "org.sylin.koi",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Koi",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "create": false,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5641; img-src 'self' data: asset:; style-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/koi.ico", "icons/koi.png"]
  }
}
