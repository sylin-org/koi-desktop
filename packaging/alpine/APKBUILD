# Maintainer: Sylin <hello@sylin.org>

pkgname=koi-desktop
pkgver=0.1.3_git20260905
pkgrel=1
pkgdesc="Koi's native network workbench"
url="https://github.com/sylin-org/koi-desktop"
arch="x86_64 aarch64"
license="MIT OR Apache-2.0"
depends="xdg-utils polkit"
makedepends="
	build-base
	cargo
	git
	gtk+3.0-dev
	libayatana-appindicator-dev
	rust
	webkit2gtk-4.1-dev
	"
checkdepends="desktop-file-utils nodejs"
subpackages="$pkgname-doc"
# Cargo fetches the locked crates and pinned Tao revision during local builds.
options="net"
_commit=ccee0fce1bb579e032a0aad2a8603f869b22a2b2
source="$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
builddir="$srcdir/$pkgname-$_commit"

build() {
	RUSTFLAGS="$RUSTFLAGS -C target-feature=-crt-static" \
		CARGO_TARGET_DIR="$srcdir/target" \
		cargo build --locked --release
}

check() {
	RUSTFLAGS="$RUSTFLAGS -C target-feature=-crt-static" \
		CARGO_TARGET_DIR="$srcdir/target" \
		cargo test --locked
	node --test ui/app.test.mjs
	desktop-file-validate packaging/arch/koi-desktop.desktop
}

package() {
	install -Dm755 "$srcdir/target/release/koi-desktop" \
		"$pkgdir/usr/bin/koi-desktop"
	install -Dm644 packaging/arch/koi-desktop.desktop \
		"$pkgdir/usr/share/applications/koi-desktop.desktop"
	install -Dm644 icons/koi.png \
		"$pkgdir/usr/share/pixmaps/koi.png"
	install -Dm644 README.md \
		"$pkgdir/usr/share/doc/koi-desktop/README.md"
}

sha512sums="
73613063683ca1a981d880e4db74ff74c44802dd786a65245ff7cf5b9e57f7bda1cf2f89f33a4e88800fb958120afa6c8d6fc26a6a239981fbe0a0c67874aafd  koi-desktop-ccee0fce1bb579e032a0aad2a8603f869b22a2b2.tar.gz
"
